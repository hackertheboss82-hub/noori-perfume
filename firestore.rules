rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- helpers ---------- */
    function signedIn() {
      return request.auth != null;
    }
    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function profileExists() {
      return signedIn() && exists(profilePath());
    }
    function myRole() {
      return get(profilePath()).data.role;
    }
    function myShop() {
      return get(profilePath()).data.shopId;
    }
    function isOwner() {
      return profileExists() && myRole() == 'owner';
    }
    function sameShop(shopId) {
      return profileExists() && myShop() == shopId;
    }

    /* ---------- staff profiles ----------
       Created once by the owner in the Firebase console.
       A user may read only their own profile and may never edit role or shopId. */
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    /* ---------- shop data ----------
       Reads are allowed for any member of the shop.
       Writes require owner, except the main app document where staff must also
       be able to save bills. Delete of the whole store data is owner-only. */
    match /shops/{shopId}/appData/{docId} {
      allow read: if sameShop(shopId);
      allow create, update: if sameShop(shopId);
      allow delete: if sameShop(shopId) && isOwner();
    }

    match /shops/{shopId}/backups/{backupId} {
      allow read: if sameShop(shopId);
      allow create: if sameShop(shopId);
      allow delete: if sameShop(shopId) && isOwner();
      allow update: if false;
    }

    /* nothing else in the shop tree is readable or writable */
    match /shops/{shopId}/{document=**} {
      allow read, write: if false;
    }
  }
}
